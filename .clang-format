# .clang-format for webserv
# Approximates 42's C-norm conventions, adapted for this project's C++98 codebase.

Language: Cpp
Standard: Cpp03

# --- Indentation ---
UseTab: Always
IndentWidth: 4
TabWidth: 4

# --- Braces: Allman style (opening brace on its own line, everywhere) ---
BreakBeforeBraces: Allman

# --- Pointers/references attached to the variable name, not the type ---
PointerAlignment: Right
ReferenceAlignment: Right

# --- General line/formatting behavior ---
ColumnLimit: 0
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 1

# --- Spacing ---
SpaceBeforeParens: ControlStatements
SpaceAfterCStyleCast: false
SpacesInParentheses: false
SpaceInEmptyParentheses: false

# --- Includes ---
SortIncludes: Never
